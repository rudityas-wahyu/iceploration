                    title: "Target X",

                    min: -10,
                    max: 10,

                    step: 0.1,

                    defaultValue: 0,
                },

                targetY: {
                    type: ControlType.Number,

                    title: "Target Y",

                    min: -10,
                    max: 10,

                    step: 0.1,

                    defaultValue: 0,
                },

