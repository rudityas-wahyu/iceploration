import * as React from "react"
import { addPropertyControls, ControlType, RenderTarget } from "framer"

/**
 * @framerSupportedLayoutWidth any
 * @framerSupportedLayoutHeight any
 */

type SourceMode = "manual" | "url"
type FitMode = "cover" | "contain" | "fill"

interface Props {
    sourceMode?: SourceMode

    // Manual
    images?: string[]

    // URL Sequence
    baseUrl?: string
    frameCount?: number
    startFrame?: number
    digits?: number
    extension?: string

    // Layout
    scrollHeight?: number
    fit?: FitMode
    positionX?: number
    positionY?: number
    background?: string

    // Animation
    smoothing?: number
    reverse?: boolean

    // Loading
    preloadAll?: boolean
    preloadRadius?: number

    // Debug
    showProgress?: boolean
    showFrame?: boolean

    style?: React.CSSProperties
}

export default function ImageScrollSequence(props: Props) {
    const {
        sourceMode = "manual",

        images = [],

        baseUrl = "",
        frameCount = 120,
        startFrame = 1,
        digits = 3,
        extension = "webp",

        scrollHeight = 500,
        fit = "cover",
        positionX = 50,
        positionY = 50,
        background = "#050510",

        smoothing = 15,
        reverse = false,

        preloadAll = true,
        preloadRadius = 15,

        showProgress = false,
        showFrame = false,

        style,
    } = props

    const sectionRef = React.useRef<HTMLDivElement>(null)

    const targetProgress = React.useRef(0)
    const smoothProgress = React.useRef(0)
    const rafRef = React.useRef<number | null>(null)

    const [currentFrame, setCurrentFrame] = React.useState(0)

    const [loadedCount, setLoadedCount] = React.useState(0)

    const isCanvas = RenderTarget.current() === RenderTarget.canvas

    /*
     * --------------------------------------------------
     * GENERATE FRAME URLS
     * --------------------------------------------------
     */

    const frames = React.useMemo(() => {
        if (sourceMode === "manual") {
            return images.filter(Boolean)
        }

        if (!baseUrl || frameCount <= 0) {
            return []
        }

        const cleanExtension = extension.startsWith(".")
            ? extension.slice(1)
            : extension

        return Array.from({ length: frameCount }, (_, index) => {
            const number = startFrame + index

            const paddedNumber = String(number).padStart(digits, "0")

            return `${baseUrl}${paddedNumber}.${cleanExtension}`
        })
    }, [sourceMode, images, baseUrl, frameCount, startFrame, digits, extension])

    const totalFrames = frames.length

    /*
     * --------------------------------------------------
     * PRELOAD IMAGES
     * --------------------------------------------------
     */

    React.useEffect(() => {
        if (totalFrames === 0) {
            setLoadedCount(0)
            return
        }

        let cancelled = false

        setLoadedCount(0)

        const loadFrame = (src: string) => {
            const image = new Image()

            image.onload = () => {
                if (!cancelled) {
                    setLoadedCount((previous) =>
                        Math.min(previous + 1, totalFrames)
                    )
                }
            }

            image.onerror = () => {
                if (!cancelled) {
                    console.warn("Failed to preload:", src)
                }
            }

            image.src = src
        }

        if (preloadAll) {
            frames.forEach(loadFrame)
        } else {
            /*
             * Initially preload beginning of sequence.
             */
            const amount = Math.min(preloadRadius, totalFrames)

            for (let i = 0; i < amount; i++) {
                loadFrame(frames[i])
            }
        }

        return () => {
            cancelled = true
        }
    }, [frames, totalFrames, preloadAll, preloadRadius])

    /*
     * --------------------------------------------------
     * DYNAMIC NEARBY PRELOADING
     * --------------------------------------------------
     */

    React.useEffect(() => {
        if (preloadAll || totalFrames === 0 || isCanvas) {
            return
        }

        const start = Math.max(currentFrame - preloadRadius, 0)

        const end = Math.min(currentFrame + preloadRadius, totalFrames - 1)

        for (let i = start; i <= end; i++) {
            const image = new Image()
            image.src = frames[i]
        }
    }, [currentFrame, preloadAll, preloadRadius, totalFrames, frames, isCanvas])

    /*
     * --------------------------------------------------
     * SCROLL ENGINE
     * --------------------------------------------------
     */

    React.useEffect(() => {
        if (isCanvas || totalFrames <= 1) return

        const section = sectionRef.current

        if (!section) return

        let destroyed = false

        const clamp = (value: number, min = 0, max = 1) =>
            Math.min(Math.max(value, min), max)

        const calculateScroll = () => {
            const rect = section.getBoundingClientRect()

            const distance = section.offsetHeight - window.innerHeight

            if (distance <= 0) {
                targetProgress.current = 0
                return
            }

            let progress = -rect.top / distance

            progress = clamp(progress)

            if (reverse) {
                progress = 1 - progress
            }

            targetProgress.current = progress
        }

        const animate = () => {
            if (destroyed) return

            const target = targetProgress.current

            const current = smoothProgress.current

            /*
             * 0 = direct
             * higher = smoother
             */
            const easing =
                smoothing <= 0 ? 1 : Math.max(0.06, 1 - smoothing / 100)

            const next = current + (target - current) * easing

            smoothProgress.current =
                Math.abs(target - next) < 0.0001 ? target : next

            const frame = Math.round(smoothProgress.current * (totalFrames - 1))

            setCurrentFrame((previous) =>
                previous === frame ? previous : frame
            )

            rafRef.current = requestAnimationFrame(animate)
        }

        calculateScroll()

        /*
         * If page loads while already scrolled.
         */
        smoothProgress.current = targetProgress.current

        window.addEventListener("scroll", calculateScroll, { passive: true })

        window.addEventListener("resize", calculateScroll)

        rafRef.current = requestAnimationFrame(animate)

        return () => {
            destroyed = true

            window.removeEventListener("scroll", calculateScroll)

            window.removeEventListener("resize", calculateScroll)

            if (rafRef.current !== null) {
                cancelAnimationFrame(rafRef.current)
            }
        }
    }, [isCanvas, totalFrames, smoothing, reverse])

    /*
     * --------------------------------------------------
     * CURRENT IMAGE
     * --------------------------------------------------
     */

    const safeFrame =
        totalFrames > 0
            ? Math.min(Math.max(currentFrame, 0), totalFrames - 1)
            : 0

    const currentImage = totalFrames > 0 ? frames[safeFrame] : undefined

    const progress =
        totalFrames > 1 ? Math.round((safeFrame / (totalFrames - 1)) * 100) : 0

    const loadingProgress =
        totalFrames > 0 ? Math.round((loadedCount / totalFrames) * 100) : 0

    /*
     * --------------------------------------------------
     * RENDER
     * --------------------------------------------------
     */

    return (
        <div
            ref={sectionRef}
            style={{
                ...style,

                position: "relative",

                width: "100%",

                height: isCanvas ? "100%" : `${scrollHeight}vh`,

                background,
            }}
        >
            <div
                style={{
                    position: isCanvas ? "relative" : "sticky",

                    top: 0,

                    width: "100%",

                    height: isCanvas ? "100%" : "100vh",

                    overflow: "clip",

                    background,

                    transform: "translate3d(0,0,0)",

                    backfaceVisibility: "hidden",
                }}
            >
                {currentImage ? (
                    <img
                        src={currentImage}
                        alt=""
                        draggable={false}
                        decoding="async"
                        style={{
                            width: "100%",
                            height: "100%",

                            display: "block",

                            objectFit: fit,

                            objectPosition: `${positionX}% ${positionY}%`,

                            pointerEvents: "none",

                            userSelect: "none",

                            WebkitUserSelect: "none",

                            transform: "translate3d(0,0,0)",

                            backfaceVisibility: "hidden",
                        }}
                    />
                ) : (
                    <EmptyState sourceMode={sourceMode} />
                )}

                {(showProgress || showFrame) && (
                    <div
                        style={{
                            position: "absolute",

                            right: 20,
                            bottom: 20,

                            display: "flex",
                            gap: 10,

                            padding: "8px 12px",

                            borderRadius: 999,

                            background: "rgba(0,0,0,.6)",

                            color: "white",

                            backdropFilter: "blur(12px)",

                            WebkitBackdropFilter: "blur(12px)",

                            fontFamily: "Inter, sans-serif",

                            fontSize: 12,
                            fontWeight: 600,

                            pointerEvents: "none",
                        }}
                    >
                        {showFrame && (
                            <span>
                                {totalFrames > 0
                                    ? `${safeFrame + 1}/${totalFrames}`
                                    : "0/0"}
                            </span>
                        )}

                        {showProgress && <span>{progress}%</span>}

                        {preloadAll && showProgress && (
                            <span
                                style={{
                                    opacity: 0.6,
                                }}
                            >
                                Load {loadingProgress}%
                            </span>
                        )}
                    </div>
                )}
            </div>
        </div>
    )
}

/*
 * --------------------------------------------------
 * EMPTY STATE
 * --------------------------------------------------
 */

function EmptyState({ sourceMode }: { sourceMode: SourceMode }) {
    return (
        <div
            style={{
                width: "100%",
                height: "100%",

                display: "grid",
                placeItems: "center",

                padding: 30,

                color: "rgba(255,255,255,.55)",

                fontFamily: "Inter, sans-serif",

                fontSize: 14,

                textAlign: "center",
            }}
        >
            {sourceMode === "manual"
                ? "Add images from the Frames property."
                : "Enter a Base URL and Frame Count."}
        </div>
    )
}

/*
 * --------------------------------------------------
 * FRAMER CONTROLS
 * --------------------------------------------------
 */

addPropertyControls(ImageScrollSequence, {
    sourceMode: {
        type: ControlType.Enum,
        title: "Source",

        options: ["manual", "url"],

        optionTitles: ["Manual Images", "URL Sequence"],

        defaultValue: "manual",

        displaySegmentedControl: true,
    },

    /*
     * MANUAL MODE
     */

    images: {
        type: ControlType.Array,
        title: "Frames",

        control: {
            type: ControlType.Image,
        },

        maxCount: 300,

        hidden(props) {
            return props.sourceMode !== "manual"
        },
    },

    /*
     * URL MODE
     */

    baseUrl: {
        type: ControlType.String,
        title: "Base URL",

        placeholder: "https://site.com/frames/frame-",

        hidden(props) {
            return props.sourceMode !== "url"
        },
    },

    frameCount: {
        type: ControlType.Number,
        title: "Frames",

        min: 1,
        max: 1000,
        step: 1,

        defaultValue: 120,

        hidden(props) {
            return props.sourceMode !== "url"
        },
    },

    startFrame: {
        type: ControlType.Number,
        title: "Start",

        min: 0,
        max: 9999,
        step: 1,

        defaultValue: 1,

        hidden(props) {
            return props.sourceMode !== "url"
        },
    },

    digits: {
        type: ControlType.Number,
        title: "Digits",

        min: 1,
        max: 6,
        step: 1,

        defaultValue: 3,

        hidden(props) {
            return props.sourceMode !== "url"
        },
    },

    extension: {
        type: ControlType.Enum,
        title: "Format",

        options: ["webp", "jpg", "jpeg", "png", "avif"],

        optionTitles: ["WebP", "JPG", "JPEG", "PNG", "AVIF"],

        defaultValue: "webp",

        hidden(props) {
            return props.sourceMode !== "url"
        },
    },

    /*
     * SCROLL
     */

    scrollHeight: {
        type: ControlType.Number,
        title: "Scroll",

        min: 200,
        max: 1500,
        step: 50,

        unit: "vh",

        defaultValue: 500,
    },

    smoothing: {
        type: ControlType.Number,
        title: "Smooth",

        min: 0,
        max: 70,
        step: 1,

        defaultValue: 15,
    },

    reverse: {
        type: ControlType.Boolean,
        title: "Reverse",

        defaultValue: false,

        enabledTitle: "Yes",
        disabledTitle: "No",
    },

    /*
     * IMAGE
     */

    fit: {
        type: ControlType.Enum,
        title: "Fit",

        options: ["cover", "contain", "fill"],

        optionTitles: ["Cover", "Contain", "Fill"],

        defaultValue: "cover",
    },

    positionX: {
        type: ControlType.Number,
        title: "Position X",

        min: 0,
        max: 100,
        step: 1,

        unit: "%",

        defaultValue: 50,
    },

    positionY: {
        type: ControlType.Number,
        title: "Position Y",

        min: 0,
        max: 100,
        step: 1,

        unit: "%",

        defaultValue: 50,
    },

    /*
     * PRELOAD
     */

    preloadAll: {
        type: ControlType.Boolean,
        title: "Preload",

        defaultValue: true,

        enabledTitle: "All",
        disabledTitle: "Nearby",
    },

    preloadRadius: {
        type: ControlType.Number,
        title: "Buffer",

        min: 3,
        max: 50,
        step: 1,

        defaultValue: 15,

        hidden(props) {
            return props.preloadAll !== false
        },
    },

    /*
     * DEBUG
     */

    showProgress: {
        type: ControlType.Boolean,
        title: "Progress",

        defaultValue: false,
    },

    showFrame: {
        type: ControlType.Boolean,
        title: "Frame No.",

        defaultValue: false,
    },

    background: {
        type: ControlType.Color,
        title: "Background",

        defaultValue: "#050510",
    },
})
